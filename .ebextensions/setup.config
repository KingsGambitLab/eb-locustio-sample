packages:
  yum:
    gcc-c++: []
    python3: []
  python:
    pyzmq: [ "25.1.1" ]
    locust: [ "2.17.0" ]
    websocket-client: []

option_settings:
  aws:elasticbeanstalk:application:environment:
    MASTER_IP_TABLE: '`{ "Ref" : "MasterIPTable"}`'
    EB_ENV_NAME: '`{"Ref" : "AWSEBEnvironmentName"}`'

commands:
  01_create_home_dir:
    command: "mkdir -p /home/webapp && chown webapp:webapp /home/webapp"
  02_copy_deploy_manifest:
    command: "if [ -f /opt/elasticbeanstalk/deployment/app_version_manifest.json ]; then cp /opt/elasticbeanstalk/deployment/app_version_manifest.json /tmp/manifest && chmod 777 /tmp/manifest; else echo 'Manifest file not found, creating dummy'; echo '{\"DeploymentId\":1,\"Serial\":1}' > /tmp/manifest && chmod 777 /tmp/manifest; fi"
  03_install_ruby_gems:
    command: "yum install -y ruby rubygems ruby-devel"
  04_install_aws_sdk:
    command: "gem install aws-sdk rexml"

files:
  # Systemd service for locust master
  "/etc/systemd/system/locust-master.service":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Locust Master Process
      After=network.target

      [Service]
      Type=simple
      User=webapp
      WorkingDirectory=/var/app/current
      Environment=PATH=/usr/local/bin:/usr/bin:/bin
      ExecStart=/usr/bin/locust -f locustfinal.py --web-host 0.0.0.0 --web-port 9876 --master
      Restart=always
      RestartSec=10

      [Install]
      WantedBy=multi-user.target

  # Systemd service template for locust workers
  "/etc/systemd/system/locust-worker@.service":
    mode: "000644"
    owner: root
    group: root
    content: |
      [Unit]
      Description=Locust Worker Process %i
      After=network.target

      [Service]
      Type=simple
      User=webapp
      WorkingDirectory=/var/app/current
      Environment=PATH=/usr/local/bin:/usr/bin:/bin
      ExecStart=/bin/bash -c "exec /usr/bin/locust -f locustfinal.py --worker --master-host=$(<.masterIP)"
      Restart=always
      RestartSec=10

      [Install]
      WantedBy=multi-user.target

  # Script to start appropriate services
  "/opt/locust_manager.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      cd /var/app/current
      
      # Stop any existing services
      systemctl stop locust-master 2>/dev/null || true
      for i in {1..8}; do
        systemctl stop locust-worker@$i 2>/dev/null || true
      done
      
      # Check if this instance is master
      if [ -f ".master" ]; then
        echo "Starting as MASTER"
        systemctl enable locust-master
        systemctl start locust-master
        
        # Get number of cores and start workers (cores - 1)
        CORES=$(nproc)
        WORKERS=$((CORES > 1 ? CORES - 1 : 0))
        echo "Master instance with $CORES cores, starting $WORKERS workers."
        if [ "$WORKERS" -gt 0 ]; then
          for i in $(seq 1 $WORKERS); do
            systemctl enable locust-worker@$i
            systemctl start locust-worker@$i
          done
        fi
      else
        echo "Starting as WORKER (follower)"
        # Start all workers based on number of cores
        CORES=$(nproc)
        echo "Worker instance with $CORES cores, starting $CORES workers."
        if [ "$CORES" -gt 0 ]; then
          for i in $(seq 1 $CORES); do
            systemctl enable locust-worker@$i
            systemctl start locust-worker@$i
          done
        fi
      fi

  # Debug script for Ruby execution
  "/opt/run_build.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      LOGFILE="/var/log/eb-ruby-debug.log"
      NGINX_SOURCE_CONFIG_IN_BUNDLE=".platform/nginx/nginx.conf" # Relative to /var/app/ondeck
      # NGINX_TARGET_CONFIG_ON_SYSTEM="/etc/nginx/nginx.conf" # No longer needed, platform handles this
      
      RUBY_BUILD_EXIT_CODE=0

      # All output from this block goes to the log file and stdout/stderr
      {
        echo "=== Ruby Build & Nginx Setup Log - $(date) ==="
        
        cd /var/app/ondeck
        echo "Working directory: $(pwd)"
        
        # Adjust path for ls -la if necessary, or remove if .platform/nginx is standard
        echo "Files in .platform/nginx before build.rb (if directory exists):"
        if [ -d ".platform/nginx" ]; then
          ls -la .platform/nginx/
        else
          echo ".platform/nginx directory not found."
        fi

        echo "=== Running ruby build.rb ==="
        ruby build.rb
        RUBY_BUILD_EXIT_CODE=$?
        echo "=== Ruby script build.rb exited with code: $RUBY_BUILD_EXIT_CODE ==="

        if [ $RUBY_BUILD_EXIT_CODE -eq 0 ]; then
          echo "build.rb script completed successfully."
          if [ -f "$NGINX_SOURCE_CONFIG_IN_BUNDLE" ]; then
            echo "Source Nginx config $NGINX_SOURCE_CONFIG_IN_BUNDLE found (platform will process this). Contents:"
            cat "$NGINX_SOURCE_CONFIG_IN_BUNDLE"
            # The platform will handle copying this to /etc/nginx/nginx.conf
            echo "The Elastic Beanstalk platform will use this file to configure Nginx."
          else
            echo "ERROR: Source Nginx config $NGINX_SOURCE_CONFIG_IN_BUNDLE not found after build.rb execution! Platform might use a default."
          fi
        else
          echo "ERROR: build.rb script failed with exit code $RUBY_BUILD_EXIT_CODE. Nginx config in bundle might be inconsistent."
          echo "Showing content of $NGINX_SOURCE_CONFIG_IN_BUNDLE (if it exists):"
          if [ -f "$NGINX_SOURCE_CONFIG_IN_BUNDLE" ]; then
            cat "$NGINX_SOURCE_CONFIG_IN_BUNDLE"
          else
            echo "$NGINX_SOURCE_CONFIG_IN_BUNDLE not found."
          fi
        fi
        echo "=== End of Ruby Build & Nginx Setup Log ==="
      } | tee -a $LOGFILE
      
      # Exit with the original exit code of ruby build.rb
      exit $RUBY_BUILD_EXIT_CODE

  # add configuration to display the locust log files when tailing logs
  "/opt/elasticbeanstalk/tasks/taillogs.d/locustio.conf":
    owner: root
    group: root
    mode: "000644"
    content: |
      /var/log/locust-master*.log
      /var/log/locust-worker*.log

container_commands:
  01_debug_environment:
    command: "pwd && ls -la /var/app/ && echo 'Current user:' && whoami"
    leader_only: true
  02_check_ruby:
    command: "which ruby && ruby --version"
    leader_only: true
  03_find_build_script:
    command: "find /var/app -name 'build.rb' -type f"
    leader_only: true
  04_setup_master_selection:
    command: "/opt/run_build.sh"
    leader_only: false

  05_setup_processes:
    command: "/opt/locust_manager.sh"
    leader_only: false
  06_reload_nginx:
    command: "sudo systemctl restart nginx"
    leader_only: false # Reload on all instances, though primarily master matters for this proxy
